# Gemini API (Free tier from Google AI Studio - Ethiopia supported)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_URL=your gemini_url_here

# Cloudflare Workers AI (Free daily allowance for FLUX.1 schnell / FLUX.2 klein)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_FLUX_URL=your_cloudflare_flux_url_here

# Optional: Kaggle API for Wan 2.2 batch jobs (phone-verified free tier)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_API_URL=your_kaggle_api_url_here
